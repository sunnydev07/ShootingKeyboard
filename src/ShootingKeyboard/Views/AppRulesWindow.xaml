<Window x:Class="ShootingKeyboard.Views.AppRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ShootingKeyboard.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:AppRulesViewModel}"
        Title="Shooting Keyboard — Per-App Rules"
        Height="540"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#1E222B"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEFF4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D3340"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderBrush" Value="#4C566A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B4252"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Per-Application Playback Rules" FontSize="20" FontWeight="Bold" Foreground="#88C0D0"/>
            <TextBlock Text="Mute, disable, or switch sound packs automatically when specific apps are in the foreground" FontSize="12" Foreground="#81A1C1" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#252A34" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Add Rule" Command="{Binding AddRuleCommand}" Margin="0,0,8,0" Background="#5E81AC"/>
                <Button Content="+ Add Current Foreground App" Command="{Binding AddCurrentAppCommand}"/>
            </StackPanel>
        </Border>

        <!-- Rules List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#252A34" CornerRadius="4" Padding="12,8" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Process Name (.exe)" FontSize="10" Foreground="#81A1C1"/>
                                    <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#1E222B"
                                             Foreground="#ECEFF4"
                                             BorderBrush="#4C566A"
                                             Padding="4,2"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Content="Disable"
                                          IsChecked="{Binding DisableSounds}"
                                          VerticalAlignment="Center"
                                          Margin="0,10,12,0"/>

                                <CheckBox Grid.Column="2"
                                          Content="Mute Only"
                                          IsChecked="{Binding MuteOnly}"
                                          VerticalAlignment="Center"
                                          Margin="0,10,12,0"/>

                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="Sound Pack Override (Optional)" FontSize="10" Foreground="#81A1C1"/>
                                    <ComboBox ItemsSource="{Binding DataContext.AvailablePacks, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding SoundPackIdOverride}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Height="28"/>
                                </StackPanel>

                                <Button Grid.Column="4"
                                        Content="✕"
                                        ToolTip="Remove Rule"
                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="30"
                                        Height="28"
                                        Margin="0,12,0,0"
                                        Background="#BF616A"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" BorderBrush="#3B4252" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0"/>
                <Button Content="Save Rules" Command="{Binding SaveCommand}" Background="#5E81AC" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
